# Backend Go (laptop teman)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tumbuh?sslmode=disable
ENGINE_URL=http://192.168.43.20:8001/engine/v1
CORS_ORIGIN=http://localhost:5173

# Frontend
VITE_API_URL=http://localhost:8080/api/v1

# Engine (laptop Zena)
ENGINE_HOST=0.0.0.0
ENGINE_PORT=8001
# Asisten LLM (dibaca Go, kontrak v0.8). Model: lihat `ollama list` di laptop yang menjalankan Ollama.
LLM_ENABLED=false
LLM_MODEL=
OLLAMA_URL=http://127.0.0.1:11434
LLM_TIMEOUT=90

# Login (kosong = demo tanpa login). otp_email butuh SMTP_*; frontend belum punya layar login.
AUTH_MODE=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
